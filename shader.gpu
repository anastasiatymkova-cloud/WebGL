"use strict";

// ControlTask - Variant 18
// Three-texture rendering with normal priority

// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec3 tangent;
attribute vec2 tex;

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 ModelViewMatrix;

varying vec2 vTexCoord;
varying vec3 vPositionEye;
varying vec3 vNormalEye;
varying vec3 vTangentEye;

void main() {
    // Vertex position in eye coordinates
    vec4 eyePosition =
        ModelViewMatrix * vec4(vertex, 1.0);

    vPositionEye = eyePosition.xyz;

    // Pass texture coordinates
    vTexCoord = tex;

    // Transform normal to eye coordinates
    vNormalEye =
        mat3(ModelViewMatrix) * normal;

    // Transform tangent to eye coordinates
    vTangentEye =
        mat3(ModelViewMatrix) * tangent;

    gl_Position =
        ModelViewProjectionMatrix *
        vec4(vertex, 1.0);
}`;


// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
#else
    precision mediump float;
#endif

uniform vec4 color;
uniform vec3 LightPosition;

// Three texture samplers
uniform sampler2D iTMU0;
uniform sampler2D iTMU1;
uniform sampler2D iTMU2;

// Normal mapping control
uniform float NormalMapStrength;

varying vec2 vTexCoord;
varying vec3 vPositionEye;
varying vec3 vNormalEye;
varying vec3 vTangentEye;

void main() {

    // 1. Read diffuse texture
    vec4 diffuseSample =
        texture2D(iTMU0, vTexCoord);

    // 2. Read specular texture
    vec3 specularSample =
        texture2D(iTMU1, vTexCoord).rgb;

    // 3. Read normal texture
    vec3 sampledNormal =
        texture2D(iTMU2, vTexCoord).rgb;

    // Convert RGB [0,1] to normal [-1,1]
    sampledNormal =
        sampledNormal * 2.0 - 1.0;


    // GRAM-SCHMIDT ORTHOGONALIZATION
    // Variant 18: PRIORITIZE NORMAL

    // Normalize and preserve normal
    vec3 N = normalize(vNormalEye);

    // Orthogonalize tangent relative to normal
    vec3 T = normalize(
        vTangentEye -
        N * dot(N, vTangentEye)
    );

    // Calculate bitangent
    vec3 B = normalize(cross(N, T));


    // Normal mapping
    vec3 tangentNormal = normalize(
        mix(
            vec3(0.0, 0.0, 1.0),
            sampledNormal,
            NormalMapStrength
        )
    );

    // Transform normal using TBN matrix
    mat3 TBN = mat3(T, B, N);

    vec3 pixelNormal =
        normalize(TBN * tangentNormal);


    // Lighting calculations

    // Light direction
    vec3 L = normalize(
        LightPosition - vPositionEye
    );

    // View direction
    vec3 V = normalize(-vPositionEye);

    // Material color from diffuse texture
    vec3 materialDiffuse =
        diffuseSample.rgb * color.rgb;

    // Ambient component
    vec3 ambient =
        0.20 * materialDiffuse;

    // Diffuse component
    float diffuseFactor = max(
        dot(pixelNormal, L),
        0.0
    );

    vec3 diffuse =
        0.75 * diffuseFactor * materialDiffuse;


    // Specular component
    vec3 specular = vec3(0.0);

    if (diffuseFactor > 0.0) {

        vec3 R = reflect(-L, pixelNormal);

        float specularFactor = pow(
            max(dot(R, V), 0.0),
            24.0
        );

        specular =
            0.65 * specularFactor *
            specularSample;
    }


    // Final fragment color
    vec3 finalColor =
        ambient + diffuse + specular;

    gl_FragColor = vec4(
        clamp(finalColor, 0.0, 1.0),
        diffuseSample.a * color.a
    );
}`;