// Vertex shader - Gouraud Shading (Variant 18)
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 ModelViewMatrix;

uniform vec3 LightPosition;
uniform vec4 color;

varying vec4 vColor;

void main() {

    // Vertex position in eye coordinates
    vec4 eyePosition =
        ModelViewMatrix * vec4(vertex, 1.0);

    // Transform the analytic normal
    vec3 N = normalize(
        mat3(ModelViewMatrix) * normal
    );

    // Direction from the vertex to the light
    vec3 L = normalize(
        LightPosition - eyePosition.xyz
    );

    // Direction towards the viewer
    vec3 V = vec3(0.0, 0.0, 1.0);

    // Ambient component
    vec3 ambient = 0.20 * color.rgb;

    // Diffuse component
    float diffuseFactor = max(dot(N, L), 0.0);

    vec3 diffuse =
        0.75 * diffuseFactor * color.rgb;

    // Specular component
    vec3 specular = vec3(0.0);

    if (diffuseFactor > 0.0) {

        vec3 R = reflect(-L, N);

        float specularFactor = pow(
            max(dot(R, V), 0.0),
            24.0
        );

        specular =
            0.55 * specularFactor * vec3(1.0);
    }

    // Final Gouraud illumination
    vec3 finalColor =
        ambient + diffuse + specular;

    vColor = vec4(
        clamp(finalColor, 0.0, 1.0),
        color.a
    );

    gl_Position =
        ModelViewProjectionMatrix *
        vec4(vertex, 1.0);
}`;


// Fragment shader - interpolated Gouraud color
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
#else
    precision mediump float;
#endif

varying vec4 vColor;

void main() {
    gl_FragColor = vColor;
}`;
